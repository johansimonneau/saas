---
import { SITE } from '../config';
interface Props { slot?: string; label?: string }
const { slot = '', label = 'Publicité' } = Astro.props;
---
{SITE.adsensePublisherId && slot && (
  <aside class="ad" aria-label={label}>
    <small>{label}</small>
    <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsensePublisherId}
      data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
  </aside>
)}
<script>
  // Script traité par Astro (dédoublonné, autorisé par la CSP) : un push par emplacement présent dans la page.
  const w = window as any;
  document.querySelectorAll('ins.adsbygoogle').forEach(() => (w.adsbygoogle = w.adsbygoogle || []).push({}));
</script>
<style>
  .ad { margin: 2rem 0; min-height: 90px; text-align: center; }
  .ad small { display: block; color: #777; font-size: .7rem; }
</style>
