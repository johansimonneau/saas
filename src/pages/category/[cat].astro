---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, catSlug } from '../../config';
export function getStaticPaths() {
  return CATEGORIES.map(c => ({ params: { cat: catSlug(c) }, props: { name: c } }));
}
const { name } = Astro.props;
const now = new Date();
const reviews = (await getCollection('reviews', r => !r.data.draft && r.data.pubDate <= now && r.data.category === name))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title={`Meilleurs outils SaaS : ${name}`} description={`Tests concrets des outils SaaS ${name} : tarifs, avantages, limites et alternatives.`}>
  <h1>Outils {name}</h1>
  {reviews.length === 0 ? <p>Bientôt disponible.</p> : <ul>{reviews.map(r => <li><a href={`/reviews/${r.id}/`}>{r.data.title}</a></li>)}</ul>}
</Base>
