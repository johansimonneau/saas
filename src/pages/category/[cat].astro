---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../config';
export function getStaticPaths() {
  return CATEGORIES.map(c => ({ params: { cat: c.toLowerCase().replace(/\s+/g, '-') }, props: { name: c } }));
}
const { name } = Astro.props;
const now = new Date();
const reviews = (await getCollection('reviews', r => !r.data.draft && r.data.pubDate <= now && r.data.category === name))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title={`Best ${name} SaaS tools`} description={`Hands-on reviews of ${name} SaaS tools: pricing, pros, cons and alternatives.`}>
  <h1>{name} tools</h1>
  {reviews.length === 0 ? <p>Coming soon.</p> : <ul>{reviews.map(r => <li><a href={`/reviews/${r.id}/`}>{r.data.title}</a></li>)}</ul>}
</Base>
