---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const now = new Date();
  const reviews = await getCollection('reviews', r => !r.data.draft && r.data.pubDate <= now);
  return reviews.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const ctaUrl = data.tool.affiliateUrl ?? data.tool.website;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  headline: data.title,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  itemReviewed: { '@type': 'SoftwareApplication', name: data.tool.name, applicationCategory: 'BusinessApplication', url: data.tool.website },
  ...(data.rating && { reviewRating: { '@type': 'Rating', ratingValue: data.rating, bestRating: 5 } }),
};
---
<Base title={data.title} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article>
    <h1>{data.title}</h1>
    <p><small>By {SITE.author} · {data.pubDate.toISOString().slice(0, 10)}{data.updatedDate && ` · updated ${data.updatedDate.toISOString().slice(0, 10)}`}</small></p>
    <p><small>Disclosure: some links are affiliate links; they never influence our verdict. <a href="/disclosure/">Details</a></small></p>

    <table>
      <tbody>
        <tr><th>Best for</th><td>{data.tool.bestFor}</td></tr>
        <tr><th>Pricing</th><td>{data.tool.pricing}</td></tr>
        <tr><th>Category</th><td>{data.category}</td></tr>
        {data.rating && <tr><th>Our rating</th><td>{data.rating} / 5</td></tr>}
        <tr><th>How we tested</th><td>{data.handsOn.testedFor}</td></tr>
      </tbody>
    </table>

    <AffiliateCTA name={data.tool.name} url={ctaUrl} trial={data.tool.freeTrial} pricing={data.tool.pricing} />
    <p><strong>Our verdict:</strong> {data.handsOn.verdict}</p>
    <AdSlot slot="" label="Advertisement" />

    <Content />

    {(data.pros.length > 0 || data.cons.length > 0) && (
      <>
        <h2>Pros and cons</h2>
        <ul>{data.pros.map(p => <li>👍 {p}</li>)}{data.cons.map(c => <li>👎 {c}</li>)}</ul>
      </>
    )}
    {data.alternatives.length > 0 && <p><strong>Alternatives:</strong> {data.alternatives.join(', ')}</p>}

    <AdSlot slot="" label="Advertisement" />
    <AffiliateCTA name={data.tool.name} url={ctaUrl} trial={data.tool.freeTrial} pricing={data.tool.pricing} />
  </article>
</Base>
