---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const now = new Date();
  const reviews = await getCollection('reviews', r => !r.data.draft && r.data.pubDate <= now);
  return reviews.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const ctaUrl = data.tool.affiliateUrl ?? data.tool.website;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  headline: data.title,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  itemReviewed: { '@type': 'SoftwareApplication', name: data.tool.name, applicationCategory: 'BusinessApplication', url: data.tool.website },
  ...(data.rating && { reviewRating: { '@type': 'Rating', ratingValue: data.rating, bestRating: 5 } }),
};
---
<Base title={data.title} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article>
    <h1>{data.title}</h1>
    <p><small>Par {SITE.author} · {data.pubDate.toISOString().slice(0, 10)}{data.updatedDate && ` · mis à jour le ${data.updatedDate.toISOString().slice(0, 10)}`}</small></p>
    <p><small>Transparence : certains liens sont affiliés, sans jamais influencer notre avis. <a href="/disclosure/">Détails</a></small></p>

    <table>
      <tbody>
        <tr><th>Idéal pour</th><td>{data.tool.bestFor}</td></tr>
        <tr><th>Tarifs</th><td>{data.tool.pricing}</td></tr>
        <tr><th>Catégorie</th><td>{data.category}</td></tr>
        {data.rating && <tr><th>Notre note</th><td>{data.rating} / 5</td></tr>}
        <tr><th>Comment nous avons testé</th><td>{data.handsOn.testedFor}</td></tr>
      </tbody>
    </table>

    <AffiliateCTA name={data.tool.name} url={ctaUrl} trial={data.tool.freeTrial} pricing={data.tool.pricing} />
    <p><strong>Notre verdict :</strong> {data.handsOn.verdict}</p>
    <AdSlot slot="" label="Publicité" />

    <Content />

    {(data.pros.length > 0 || data.cons.length > 0) && (
      <>
        <h2>Avantages et limites</h2>
        <ul>{data.pros.map(p => <li>👍 {p}</li>)}{data.cons.map(c => <li>👎 {c}</li>)}</ul>
      </>
    )}
    {data.alternatives.length > 0 && <p><strong>Alternatives :</strong> {data.alternatives.join(', ')}</p>}

    <AdSlot slot="" label="Publicité" />
    <AffiliateCTA name={data.tool.name} url={ctaUrl} trial={data.tool.freeTrial} pricing={data.tool.pricing} />
  </article>
</Base>
