---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, catSlug } from '../../config';
const now = new Date();
const reviews = (await getCollection('reviews', r => !r.data.draft && r.data.pubDate <= now))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Tous les tests SaaS" description="Tous les outils SaaS testés, du plus récent au plus ancien : tarifs, avantages, limites et alternatives.">
  <h1>Tous les tests SaaS</h1>
  <p>
    {CATEGORIES.map(c => <a href={`/category/${catSlug(c)}/`}>{c} </a>)}
  </p>
  <ul>{reviews.map(r => <li><a href={`/reviews/${r.id}/`}>{r.data.title}</a> <small>({r.data.category})</small></li>)}</ul>
</Base>
