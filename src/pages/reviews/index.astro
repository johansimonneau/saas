---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../config';
const now = new Date();
const reviews = (await getCollection('reviews', r => !r.data.draft && r.data.pubDate <= now))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="All SaaS reviews" description="Every SaaS tool we've tested, newest first, with pricing, pros, cons and alternatives.">
  <h1>All SaaS reviews</h1>
  <p>
    {CATEGORIES.map(c => <a href={`/category/${c.toLowerCase().replace(/\s+/g, '-')}/`}>{c} </a>)}
  </p>
  <ul>{reviews.map(r => <li><a href={`/reviews/${r.id}/`}>{r.data.title}</a> <small>({r.data.category})</small></li>)}</ul>
</Base>
