---
import Base from '../../layouts/Base.astro';
import { BLOG_CATEGORIES } from '../../config';
import { getPosts, fmtDate } from '../../lib/content';
const posts = await getPosts();
const featured = posts.find(p => p.data.featured) ?? posts[0];
const rest = posts.filter(p => p !== featured);
---
<Base title="Le blog" description="Guides, comparatifs et retours d'expérience pour choisir et bien utiliser ses outils SaaS quand on est indépendant ou dirigeant de TPE.">
  <section class="hero">
    <span class="chip lime">Le blog</span>
    <h1>Guides, comparatifs et <span class="hl">retours d'expérience</span>.</h1>
    <p class="lead">Les outils SaaS vus par un indépendant qui les utilise vraiment : ce qui marche, ce qui coûte, et quand passer son chemin.</p>
    <p class="stack">{BLOG_CATEGORIES.map(c => <span class="chip">{c}</span>)}</p>
  </section>

  {!featured ? <p class="muted">Les premiers articles arrivent.</p> : (
    <>
      <a class="card feat" href={`/blog/${featured.id}/`}>
        <span class="chip accent">À la une · {featured.data.category}</span>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <p class="meta">{fmtDate(featured.data.pubDate)} · {featured.data.author}</p>
      </a>
      {rest.length > 0 && (
        <div class="grid">{rest.map(p => (
          <a class="card post" href={`/blog/${p.id}/`}>
            <span class="chip">{p.data.category}</span>
            <h3>{p.data.title}</h3>
            <p class="muted">{p.data.description}</p>
            <p class="meta">{fmtDate(p.data.pubDate)}</p>
          </a>))}</div>
      )}
    </>
  )}
</Base>
<style>
  .feat { display: block; text-decoration: none; color: var(--ink); background: var(--lime); margin: 1rem 0 2rem; transition: transform .08s, box-shadow .08s; }
  .feat:hover, .post:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--ink); }
  .feat h2 { margin: .5rem 0; font-size: clamp(1.6rem, 4vw, 2.3rem); }
  .feat p { margin: .4rem 0; max-width: 680px; }
  .post { display: block; text-decoration: none; color: var(--ink); transition: transform .08s, box-shadow .08s; }
  .post h3 { margin: .5rem 0; }
  .post p { margin: .3rem 0; }
  .meta { font-size: .85rem; color: var(--muted); }
</style>
