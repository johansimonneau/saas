---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { getPosts, getTools, fmtDate } from '../../lib/content';

export async function getStaticPaths() {
  return (await getPosts()).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 220));
const toc = headings.filter(h => h.depth === 2);
const toolIds = new Set((await getTools()).map(t => t.id));
const jsonLd = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description,
  datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Organization', name: d.author }, publisher: { '@type': 'Organization', name: SITE.name } };
---
<Base title={d.title} description={d.description} ogType="article" jsonLd={jsonLd}>
  <div id="progress"></div>
  <header class="hero">
    <p class="stack"><a class="chip accent" href="/blog/">{d.kicker ?? d.category}</a>{d.tags.slice(0, 3).map(t => <span class="chip">{t}</span>)}</p>
    <h1>{d.title}</h1>
    <p class="lead">{d.description}</p>
    <p class="muted by">{d.author} · {fmtDate(d.pubDate)}{d.updatedDate && ` · mis à jour le ${fmtDate(d.updatedDate)}`} · {minutes} min de lecture</p>
  </header>

  <div class="layout">
    <article class="body">
      {d.ranking.length > 0 && (
        <ol class="ranking">{d.ranking.map((r, i) => (
          <li class="card rk">
            <span class="rank">{i + 1}</span>
            <div>
              <h3>{r.slug && toolIds.has(r.slug) ? <a href={`/annuaire/${r.slug}/`}>{r.name}</a> : r.name}
                {r.tested ? <span class="chip lime">Testé par la rédaction</span> : <span class="chip">Classé sur critères publics</span>}</h3>
              <p class="muted">{r.bestFor}{r.price && ` · ${r.price}`}</p>
              <p>{r.verdict}</p>
            </div>
          </li>))}</ol>
      )}
      <Content />
      <div class="card author"><strong>{d.author}</strong><br />Des outils testés en conditions réelles, par un indépendant. <a href="/about/">Notre méthode</a>.</div>
      <div class="card more"><strong>Un outil testé par jour.</strong> <a href="/tests/">Voir les tests →</a> · <a href="/annuaire/">Parcourir l'annuaire →</a></div>
    </article>
    <aside class="side">
      {d.takeaways.length > 0 && <div class="card take"><strong>L'essentiel en 30 s</strong><ul>{d.takeaways.map(t => <li>{t}</li>)}</ul></div>}
      {toc.length > 1 && <nav class="card toc" aria-label="Sommaire"><strong>Sommaire</strong>{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>}
    </aside>
  </div>
</Base>
<style>
  #progress { position: fixed; top: 0; left: 0; height: 4px; width: 0; background: var(--brand); z-index: 20; }
  .by { font-size: .9rem; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 2.5rem; align-items: start; }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; } .side { order: -1; } }
  .body { font-size: 1.1rem; line-height: 1.75; max-width: 760px; }
  .body :global(h2) { scroll-margin-top: 90px; }
  .body :global(h2)::before { content: ''; display: inline-block; width: .55em; height: .55em; background: var(--lime); border: 2px solid var(--ink); border-radius: 4px; margin-right: .45em; }
  .body :global(h3) { margin-top: 1.6em; }
  .body :global(blockquote) { margin: 1.5rem 0; padding: .8rem 1.2rem; border-left: 8px solid var(--lime); background: var(--card); font-weight: 600; }
  .body :global(code) { background: #f0edff; padding: .1em .35em; border-radius: 5px; font-size: .9em; }
  .body :global(img) { max-width: 100%; border: 2px solid var(--ink); border-radius: var(--radius); }
  .body :global(table) { font-size: .95rem; box-shadow: var(--shadow); }
  .side { position: sticky; top: 90px; display: grid; gap: 1rem; font-size: .95rem; }
  .ranking { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 1rem; }
  .rk { display: grid; grid-template-columns: 56px 1fr; gap: 1rem; align-items: start; }
  .rk h3 { margin: 0 0 .2rem; display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
  .rk p { margin: .2rem 0; }
  .rank { display: grid; place-items: center; width: 48px; height: 48px; border: 2px solid var(--ink); border-radius: 12px; background: var(--lime); font-weight: 900; font-size: 1.4rem; }
  .take { background: var(--lime); }
  .take ul { margin: .5rem 0 0; padding-left: 1.1rem; }
  .toc a { display: block; padding: .25rem 0; color: var(--ink); text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
  .author, .more { margin-top: 2rem; font-size: 1rem; line-height: 1.55; }
  .more { background: #f4f0ff; }
</style>
<script is:inline>
  const bar = document.getElementById('progress');
  addEventListener('scroll', () => { const h = document.documentElement; bar.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight) * 100) + '%'; }, { passive: true });
</script>
