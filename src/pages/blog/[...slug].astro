---
import { render } from 'astro:content';
import BlogShell from '../../layouts/BlogShell.astro';
import { SITE } from '../../config';
import { getPosts, fmtDate } from '../../lib/content';

export async function getStaticPaths() {
  return (await getPosts()).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const words = (entry.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 220));
const toc = headings.filter(h => h.depth === 2);
const jsonLd = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description,
  datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', name: d.author }, publisher: { '@type': 'Organization', name: SITE.name } };
---
<BlogShell title={d.title} description={d.description} ogType="article" jsonLd={jsonLd}>
  <div id="progress"></div>
  <header class="phead wrap">
    <p class="kick">{d.kicker ?? d.category}</p>
    <h1>{d.title}</h1>
    <p class="by">{d.author} · {fmtDate(d.pubDate)}{d.updatedDate && ` · mis à jour le ${fmtDate(d.updatedDate)}`} · {minutes} min de lecture</p>
  </header>
  <div class="wrap layout">
    <article class="body"><Content />
      <div class="author"><strong>{d.author}</strong><br />Consultant indépendant, je teste les outils que je recommande. <a href="/about/">En savoir plus</a>.</div>
      <div class="nl"><strong>Un outil testé par jour.</strong> <a href="/tests/">Voir les derniers tests →</a> · <a href="/annuaire/">Parcourir l'annuaire →</a></div>
    </article>
    <aside class="side">
      {d.takeaways.length > 0 && <div class="box"><b>L'essentiel en 30 s</b><ul>{d.takeaways.map(t => <li>{t}</li>)}</ul></div>}
      {toc.length > 1 && <nav class="box toc" aria-label="Sommaire"><b>Sommaire</b>{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>}
    </aside>
  </div>
</BlogShell>
<style>
  #progress { position: fixed; top: 0; left: 0; height: 3px; width: 0; background: linear-gradient(90deg, var(--b-a), var(--b-b)); z-index: 20; }
  .phead { padding: 4rem 1.25rem 1.5rem; } .phead > * { max-width: 820px; }
  .kick { display: inline-block; font: 700 .78rem ui-monospace, monospace; text-transform: uppercase; letter-spacing: .1em; color: #0a0a14; background: var(--b-b); padding: .2rem .6rem; border-radius: 6px; }
  .phead h1 { font: 900 clamp(2.1rem, 6vw, 3.8rem)/1.05 ui-sans-serif, system-ui, sans-serif; letter-spacing: -.04em; margin: .4em 0; }
  .by { color: var(--b-mut); font: .9rem ui-sans-serif, system-ui, sans-serif; }
  .layout { display: grid; grid-template-columns: minmax(0, 700px) 280px; gap: 3rem; align-items: start; padding-top: 1rem; }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; } .side { order: -1; } }
  .body { font-size: 1.2rem; line-height: 1.75; }
  .body :global(h2) { font: 900 1.9rem/1.15 ui-sans-serif, system-ui, sans-serif; letter-spacing: -.03em; margin: 2.2em 0 .5em; scroll-margin-top: 80px; }
  .body :global(h2)::before { content: '#'; color: var(--b-a); margin-right: .4rem; }
  .body :global(h3) { font: 800 1.3rem ui-sans-serif, system-ui, sans-serif; color: var(--b-b); }
  .body :global(blockquote) { margin: 1.5rem 0; padding: 1rem 1.4rem; border-left: 4px solid var(--b-c); background: #12121f; border-radius: 0 12px 12px 0; font-style: italic; }
  .body :global(code) { background: #181830; padding: .1em .35em; border-radius: 5px; font-size: .9em; }
  .body :global(table) { background: #10101e; border-color: var(--b-line); } .body :global(th), .body :global(td) { border-color: var(--b-line); } .body :global(th) { background: #16162a; }
  .body :global(img) { max-width: 100%; border-radius: 14px; }
  .side { position: sticky; top: 80px; display: grid; gap: 1rem; font: .92rem ui-sans-serif, system-ui, sans-serif; }
  .box { border: 1px solid var(--b-line); border-radius: 16px; padding: 1rem 1.1rem; background: #10101e; }
  .box b { display: block; font: 700 .75rem ui-monospace, monospace; text-transform: uppercase; letter-spacing: .08em; color: var(--b-b); margin-bottom: .5rem; }
  .box ul { margin: 0; padding-left: 1.1rem; color: var(--b-fg); }
  .toc a { display: block; padding: .25rem 0; color: var(--b-mut); text-decoration: none; } .toc a:hover { color: var(--b-fg); }
  .author, .nl { margin-top: 2.5rem; padding: 1.2rem 1.4rem; border: 1px solid var(--b-line); border-radius: 16px; background: #10101e; font: 1rem/1.6 ui-sans-serif, system-ui, sans-serif; }
  .nl { background: linear-gradient(120deg, rgba(124,92,255,.25), rgba(34,228,181,.15)); }
</style>
<script is:inline>
  const bar = document.getElementById('progress');
  addEventListener('scroll', () => { const h = document.documentElement; bar.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight) * 100) + '%'; }, { passive: true });
</script>
