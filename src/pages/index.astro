---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
const now = new Date();
const reviews = (await getCollection('reviews', r => !r.data.draft && r.data.pubDate <= now))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title={SITE.name} description={SITE.tagline}>
  <h1>{SITE.tagline}</h1>
  <p>Des présentations SaaS honnêtes et testées pour les petites équipes : ce que fait l'outil, pour qui, combien il coûte, et quand l'éviter.</p>
  <h2>Derniers articles</h2>
  <ul>
    {reviews.slice(0, 20).map(r => (
      <li>
        <a href={`/reviews/${r.id}/`}>{r.data.title}</a>
        <small> — {r.data.category} · {r.data.pubDate.toISOString().slice(0, 10)}</small>
      </li>
    ))}
  </ul>
  <p><a href="/reviews/">Tout parcourir →</a></p>
</Base>
