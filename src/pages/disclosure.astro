---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base title="Affiliate disclosure" description={`How ${SITE.name} earns money and how that affects our reviews.`}>
  <h1>Affiliate disclosure</h1>
  <p>{SITE.name} earns revenue from advertising and affiliate commissions. If you click a link marked as an affiliate link and buy, we may earn a commission at no extra cost to you. Commissions never change a rating or verdict, and we review tools we don't earn from too.</p>
</Base>
