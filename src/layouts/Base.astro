---
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
interface Props { title: string; description: string; ogType?: string; jsonLd?: object | object[]; noindex?: boolean; accent?: string }
const { accent, ...rest } = Astro.props;
---
<!doctype html>
<html lang={SITE.lang}>
<head><Head {...rest} /></head>
<body style={accent ? `--accent:${accent}` : undefined}>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">SaaS<b>brief</b></a>
      <nav class="nav" aria-label="Navigation principale">
        <a href="/annuaire/">Annuaire</a>
        <a href="/tests/">Tests</a>
        <a href="/blog/">Blog</a>
        <a class="btn lime" href="/soumettre/">+ Ajouter un SaaS</a>
      </nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <Footer />
  <script is:inline>
    // Décode les données d'identité masquées (voir src/lib/mask.ts).
    window.__unmask = function (b) {
      var r = atob(b), n = r.length - 8, o = new Uint8Array(n);
      for (var i = 0; i < n; i++) o[i] = r.charCodeAt(8 + i) ^ r.charCodeAt(i % 8);
      return new TextDecoder().decode(o);
    };
    document.querySelectorAll('[data-p]').forEach(function (el) {
      try {
        var v = window.__unmask(el.getAttribute('data-p'));
        if (el.tagName === 'A') el.href = 'mailto:' + v;
        el.textContent = v; el.removeAttribute('data-p');
      } catch (e) {}
    });
  </script>
</body>
</html>
